{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/benchmark-pipeline/benchmark_item.schema.json",
  "title": "BenchmarkItem",
  "description": "A single benchmark evaluation item generated by the pipeline.",
  "type": "object",
  "required": [
    "benchmark_item_id",
    "source_packet_id",
    "language_tier",
    "question_text",
    "normalized_resident_need",
    "source_answer",
    "tags",
    "generation_metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "benchmark_item_id": {
      "type": "string",
      "pattern": "^.+__.+__\\d{4}$",
      "description": "Unique item ID in format: {source_packet_id}__{language_tier}__{NNNN}"
    },
    "source_packet_id": {
      "type": "string",
      "minLength": 1,
      "description": "ID of the source packet this item was generated from."
    },
    "language_tier": {
      "type": "string",
      "enum": ["T0", "T1", "T2", "T3"],
      "description": "Language register tier."
    },
    "question_text": {
      "type": "string",
      "minLength": 1,
      "description": "The generated benchmark question."
    },
    "official_question": {
      "type": ["string", "null"],
      "description": "Official FAQ question from the source packet (if any)."
    },
    "normalized_resident_need": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical statement of the resident's information need."
    },
    "assumed_facts": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Facts assumed true for this item."
    },
    "source_answer": {
      "type": "object",
      "description": "Structured answer information copied from the source packet.",
      "required": ["official_answer", "required_answer_elements", "forbidden_claims"],
      "properties": {
        "official_answer": {"type": "string"},
        "required_answer_elements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "optional_answer_elements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_claims": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "description": "Classification tags.",
      "properties": {
        "administrative_topic_tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_agency": {"type": "string"},
        "source_type": {"type": "string"},
        "source_url": {"type": "string"},
        "as_of_date": {"type": "string"}
      },
      "additionalProperties": true
    },
    "generation_metadata": {
      "type": "object",
      "description": "Information about how this item was generated.",
      "properties": {
        "generator_model": {"type": "string"},
        "validator_model": {"type": "string"},
        "validation_status": {"type": "string"},
        "escalated": {"type": "boolean"},
        "style_tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "language_example_ids_used": {
          "type": "array",
          "items": {"type": "string"}
        },
        "seed": {"type": ["integer", "null"]},
        "attempt": {"type": "integer"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  }
}
